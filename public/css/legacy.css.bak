body { margin:0; background:#0c0c0c; color:#c9c9a3; font-family:'Courier New', monospace; font-size:14px; }
.legacyHeader td { background:#1a1a1a; color:#e0c05c; padding:6px 10px; border-bottom:2px solid #3a3a2a; }
.legacyTitle { font-weight:bold; letter-spacing:1px; }
.legacyMeta { text-align:right; color:#6a6a4a; font-size:12px; }
.statusBar td { background:#111; padding:5px 10px; border-bottom:1px solid #2a2a1a; font-size:12px; }
.ok { color:#7fbf6a; }
.warn { color:#d99a2b; }
.unk { color:#c9532b; }
.legacyBody { max-width:640px; margin:24px auto; padding:0 16px; }
.legacyBody h2 { color:#e0c05c; border-bottom:1px dashed #3a3a2a; padding-bottom:4px; }
.legacyBody a { color:#7fa3bf; }
.legacyBody form { margin:12px 0; }
.legacyBody input[type=text] { background:#000; color:#c9c9a3; border:1px solid #3a3a2a; padding:6px; width:220px; font-family:inherit; }
.legacyBody button { background:#2a2a1a; color:#e0c05c; border:1px solid #3a3a2a; padding:6px 12px; font-family:inherit; cursor:pointer; margin-left:6px; }
.legacyBody pre { background:#000; border:1px solid #2a2a1a; padding:10px; white-space:pre-wrap; word-break:break-all; }
.legacyFooter { text-align:center; color:#3a3a2a; font-size:11px; padding:20px; }
